PORT=5092
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# MSSQL Connection Configuration
# Examples: 
# - SQL_SERVER=localhost
# - SQL_SERVER=192.168.1.50,1433
# - SQL_SERVER=COMPUTER-NAME\INSTANCE_NAME
SQL_SERVER=YOUR_SQL_SERVER
SQL_DATABASE=ETSSupportDB
SQL_USER=YOUR_SQL_USER
SQL_PASSWORD=YOUR_SQL_PASSWORD

# Use 'false' to match your .NET config (TrustServerCertificate=False)
SQL_TRUST_CERT=false

# Admin UI Configuration
ADMIN_DISPLAY_NAME=Support Admin
